{
  "service_dir": {
    "type": "string",
    "default": "/Users/hanhanpig3/Documents/文稿 - hanhanpig3的Mac mini/programe/localtts",
    "description": "本机 GPT-SoVITS 部署目录（含 .venv 虚拟环境和 GPT-SoVITS/ 源码），插件从这里启动引擎与包装服务。"
  },
  "engine_port": {
    "type": "int",
    "default": 9880,
    "description": "GPT-SoVITS 推理引擎端口。"
  },
  "tts_port": {
    "type": "int",
    "default": 9881,
    "description": "调音包装服务（AstrBot 对接）端口。"
  },
  "auto_start": {
    "type": "bool",
    "default": true,
    "description": "AstrBot 启动时自动拉起 TTS 服务。"
  },
  "default_speed": {
    "type": "float",
    "default": 1.0,
    "description": "默认语速 0.5~2.0（0.85 略慢）。"
  },
  "default_pitch": {
    "type": "float",
    "default": 0.0,
    "description": "默认音调（半音，-12~12）。"
  },
  "default_volume": {
    "type": "float",
    "default": 0.0,
    "description": "默认音量（dB，-20~20）。"
  },
  "public_url": {
    "type": "string",
    "default": "",
    "description": "对外可访问的服务地址（留空自动用 http://127.0.0.1:<tts_port>）。AstrBot 与本服务同一台机时留空即可。"
  },
  "engine_model_s2": {
    "type": "string",
    "default": "GPT_SoVITS/pretrained_models/gsv-v2final-pretrained/s2G2333k.pth",
    "description": "SoVITS 声码器模型相对 GPT-SoVITS/ 目录的路径。"
  },
  "engine_model_s1": {
    "type": "string",
    "default": "GPT_SoVITS/pretrained_models/gsv-v2final-pretrained/s1bert25hz-5kh-longer-epoch=12-step=369668.ckpt",
    "description": "GPT 语义模型相对 GPT-SoVITS/ 目录的路径。"
  }
}
